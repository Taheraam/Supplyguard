# =============================================================================
# SupplyGuard — .gitignore
# =============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment Variables & Sensitive Credentials
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# SQLite Databases & Local Scan Artifacts
*.db
*.sqlite
*.sqlite3
supplyguard.db
ci_supplyguard.db
results.sarif
bom.json
scratch/

# Testing & Coverage
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.log

# Distribution & Build Artifacts
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Agent / AI Scratch Files
.agent/
.gemini/
